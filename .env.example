# Optional. A set variable overrides the value saved in admin settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PUBLIC_BASE_URL=

X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional. Exact callback. When empty, the callback is <public base>/api/auth/x/callback.
X_REDIRECT_URI=
# Optional. Public origin for the X callback when it should not follow the browser host.
X_PUBLIC_BASE_URL=
# Optional. Shared public origin used by X, LinkedIn, and Instagram when their own public base is empty.
PUBLIC_BASE_URL=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Public origin for the LinkedIn callback when it should not follow the browser host.
# The callback is <public base>/api/auth/linkedin/callback.
LINKEDIN_PUBLIC_BASE_URL=

# Unified login (newer Meta apps): Meta app ID and secret from App settings > Basic, plus the
# Configuration ID from Use cases > Manage messaging & content on Instagram > API setup with Unified login.
# The configuration must include instagram_basic and instagram_manage_insights.
# Leave INSTAGRAM_CONFIG_ID empty only for an older app that has "API setup with Instagram login";
# then use that page's Instagram app ID and secret.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CONFIG_ID=
# Optional. "instagram" opens instagram.com/oauth/authorize instead of the Facebook Login for Business dialog.
INSTAGRAM_LOGIN_DIALOG=
# Optional. Public origin for the Instagram callback, e.g. https://aviationsminuteanalysis.com.
# The callback is <public base>/api/auth/instagram/callback. Falls back to PUBLIC_BASE_URL, then the browser host.
INSTAGRAM_PUBLIC_BASE_URL=

# Optional. Comma-separated hosts allowed to load Next.js dev assets and HMR.
# A host is also taken from TIKTOK_PUBLIC_BASE_URL, GOOGLE_REDIRECT_URI, X_PUBLIC_BASE_URL, X_REDIRECT_URI, LINKEDIN_PUBLIC_BASE_URL, INSTAGRAM_PUBLIC_BASE_URL, and PUBLIC_BASE_URL when it is not localhost.
ALLOWED_DEV_ORIGINS=
